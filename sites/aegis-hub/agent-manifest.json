{
  "brand": "Aegis: Zero-Leakage Medical Consensus Room",
  "networks": [
    {
      "name": "aegis_coordinator",
      "front_man": "chief_physician",
      "hocon": "./aegis_coordinator.network.json",
      "description": "Zero-leakage clinical second opinion coordinator. Federates decentralized medical specialist agents peer-to-peer in your browser without cloud uploads.",
      "tags": [
        "open-agentic-web",
        "healthcare-ai",
        "multi-agent-consensus",
        "zero-leakage",
        "byok"
      ],
      "sample_queries": [
        "Review the active patient case in my private vault and coordinate a multi-specialist diagnostic consensus.",
        "Check whether the patient's genetic variants conflict with their current polypharmacy regimen.",
        "Synthesize clinical consensus findings into a formal dossier for my doctor."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [
    "https://pnrs.is-a.dev",
    "http://localhost:8081",
    "http://localhost:8082",
    "http://127.0.0.1:8081",
    "http://127.0.0.1:8082",
    "http://127.0.0.1:8881",
    "http://127.0.0.1:8882"
  ],
  "peer_policy": {
    "mode": "closed",
    "deny_origins": [],
    "note": "Federates queries exclusively with approved specialist nodes after explicit visitor approval."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "aegis_coordinator",
    "front_man": "chief_physician",
    "available": false,
    "reason": "Static bundle; public MCP facade requires server host."
  },
  "theme": {
    "primary": "#0284c7"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "aegis_coordinator",
        "front_man": "chief_physician",
        "aliases": [
          "aegis_coordinator",
          "chief_physician"
        ],
        "url": "aegis_coordinator"
      }
    ],
    "imports": [
      {
        "network": "genomics_node",
        "front_man": "genomics_specialist",
        "origin": "http://localhost:8081"
      },
      {
        "network": "pharmasafe_node",
        "front_man": "pharmacology_specialist",
        "origin": "http://localhost:8082"
      }
    ],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "get_patient_clinical_record",
      "flag_clinical_contraindication",
      "generate_consensus_dossier"
    ]
  }
}
