{
  "brand": "Rare Genomics Institute",
  "networks": [
    {
      "name": "genomics_node",
      "front_man": "genomics_specialist",
      "hocon": "./genomics_node.network.json",
      "description": "Evidence-based genomic variant pathogenicity, rare disease phenotype mapping, and metabolic mutation analysis.",
      "tags": [
        "open-agentic-web",
        "genomics",
        "clinical-ai"
      ],
      "sample_queries": [
        "What are the clinical implications of PDHA1 c.1145C>T (p.Pro382Leu)?",
        "Explain the phenotype and metabolic risk of DPYD*2A variant in patients receiving fluoropyrimidines.",
        "Check genetic variant CYP2C19 *2 loss of function and its impact on clopidogrel activation."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
    "mock": false,
    "byok_router": "https://api.otari.ai/api/v1"
  },
  "allowed_peers": [],
  "peer_policy": {
    "mode": "open",
    "deny_origins": [],
    "note": "Public genomic authority node. Open to queries from any conforming agentic web client."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "genomics_node",
    "front_man": "genomics_specialist",
    "available": false,
    "reason": "Static bundle; public MCP facade requires server host."
  },
  "theme": {
    "primary": "#059669"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "genomics_node",
        "front_man": "genomics_specialist",
        "aliases": [
          "genomics_node",
          "genomics_specialist"
        ],
        "url": "genomics_node"
      }
    ],
    "imports": [],
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": true,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false
  },
  "actions": {
    "version": 1,
    "module": "./site-actions.js",
    "bridge": "./bridge/action-bridge.html",
    "agentTools": [
      "lookup_genomic_variant",
      "get_genomics_knowledge_base"
    ]
  }
}
